# DubFlow AI Configuration Template

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# NVIDIA AI APIs
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TRANSLATION_MODEL=nvidia/riva-translate-4b-instruct-v2
NVIDIA_LLM_MODEL=nvidia/riva-translate-4b-instruct-v2

# Storage Directory
STORAGE_DIR=storage

# Hardware & VRAM Optimization (e.g. RTX A2000 4GB)
DEVICE=cuda
WHISPER_MODEL_SIZE=base
WHISPER_FP16=True
MAX_VRAM_GB=3.8
AUTO_RELEASE_CUDA_CACHE=True

# Database (SQLite default, PostgreSQL ready: postgresql://user:pass@localhost:5432/dubflow)
DATABASE_URL=sqlite:///./storage/dubflow.db
